# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key
# Optional — Influx Scout baked-in rotation (up to 3 keys, auto-rotates daily
# and on quota exhaustion; only YOUTUBE_API_KEY is required)
# YOUTUBE_API_KEY_2=your-second-youtube-api-key
# YOUTUBE_API_KEY_3=your-third-youtube-api-key

# Cron / workers
CRON_SECRET=your-random-secret-string

# Admin ops dashboard (/admin) — comma-separated emails
ADMIN_EMAILS=you@example.com

# Public app URL (extension + import page)
NEXT_PUBLIC_APP_URL=https://influencer-platform-mu.vercel.app

# Contributor import (extension / paste / npm run import:lists)
# Prefer per-user key from: npm run worker:create -- --name you
# INFLUX_WORKER_KEY=iw_…
# WORKER_SUBMIT_TOKEN=your-random-worker-token

# Subscription gating
SUBSCRIPTION_DEMO_MODE=true
NEXT_PUBLIC_SUBSCRIPTION_DEMO_MODE=true
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# Optional: Upstash Redis for quota tracking
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: OpenAI for AI outreach emails (falls back to smart template if unset)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local Playwright scraper (scripts/scrape-enrich.ts)
SCRAPER_DELAY_MS=4000
SCRAPER_HEADLESS=true
SCRAPER_USE_AUTH=true

# Nightly niche scraper (npm run scrape:niches) — conservative defaults
# Target market: USA & Europe (Beauty, Gaming, Finance, Fashion)
SCRAPER_TARGET_MARKETS=true
NIGHTLY_LIMIT_PER_SEARCH=25
NIGHTLY_SEARCHES_PER_NICHE=2
NIGHTLY_DELAY_MS=5500
NIGHTLY_JITTER_MS=2000
NIGHTLY_PAUSE_SEARCH_MS=45000
NIGHTLY_PAUSE_NICHE_MS=90000
NIGHTLY_MAX_ENRICH=100
NIGHTLY_MAX_LOCKED_STREAK=5
NIGHTLY_BACKLOG_LIMIT=30

# Payments — OFF until the data is ready to sell. Set to "true" to show
# pricing/upgrade buttons and accept Stripe checkouts.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Needed only when payments are on:
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
