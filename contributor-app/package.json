{
  "name": "influx-contributor",
  "version": "1.2.9",
  "description": "Influx Contributor \u2014 share YouTube discovery quota without duplicating work",
  "main": "main.js",
  "author": "Influx",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac dmg",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win zip --x64"
  },
  "build": {
    "appId": "app.influx.contributor",
    "productName": "Influx Contributor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings-bridge.js",
      "youtube-window.js",
      "instagram-window.js",
      "renderer/**/*",
      "engine/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Influx-Contributor-${version}-windows-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
